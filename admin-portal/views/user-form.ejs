<%- include("partials/header", { title: pageTitle, loggedIn, adminEmail, notice }) %>
<section class="page-heading compact-heading">
  <div><p class="eyebrow">ADMIN WORKSPACE / USERS</p><h1><%= pageTitle %></h1><p class="lead-small">Profile details are stored in Coursewise. Passwords are managed by Supabase Auth.</p></div>
  <a class="text-link" href="/users">← Back to users</a>
</section>
<section class="form-panel">
  <form action="<%= formAction %>" method="post" class="record-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-grid">
      <div class="field full-field"><label for="user_email">Email address</label><input id="user_email" name="user_email" type="email" value="<%= user ? user.email : '' %>" maxlength="254" required></div>
      <div class="field"><label for="first_name">First name</label><input id="first_name" name="first_name" type="text" value="<%= user ? user.FirstName : '' %>" maxlength="100" required></div>
      <div class="field"><label for="last_name">Last name</label><input id="last_name" name="last_name" type="text" value="<%= user ? user.LastName : '' %>" maxlength="100" required></div>
      <div class="field full-field"><label for="username">Username</label><input id="username" name="username" type="text" value="<%= user ? user.Username : '' %>" maxlength="50" required></div>
      <div class="field full-field">
        <label for="user_password">Password <%= user ? "(leave blank to keep the current password)" : "" %></label>
        <input id="user_password" name="user_password" type="password" autocomplete="new-password" minlength="8" maxlength="72" <%= user ? "" : "required" %> placeholder="At least 8 characters">
      </div>
    </div>
    <div class="form-actions"><a class="button button-outline" href="/users">Cancel</a><button class="button button-primary" type="submit"><%= user ? "Save changes" : "Create user" %></button></div>
  </form>
</section>
<%- include("partials/footer") %>
