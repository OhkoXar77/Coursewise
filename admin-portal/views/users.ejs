<%- include("partials/header", { title: "Maintain Users", loggedIn, adminEmail, notice }) %>
<section class="page-heading">
  <div><p class="eyebrow">ADMIN WORKSPACE / USERS</p><h1>Maintain Users</h1><p class="lead-small">Manage Coursewise profiles and the accounts they use to sign in.</p></div>
  <a class="button button-primary" href="/users/new"><span aria-hidden="true">＋</span> Add user</a>
</section>
<section class="panel">
  <div class="panel-heading">
    <div><h2>User records</h2><p data-record-count data-record-label="profiles" data-record-singular="profile"><%= users.length %> profile<%= users.length === 1 ? "" : "s" %></p></div>
    <div class="panel-tools">
      <% if (users.length) { %><label class="search-box"><span class="sr-only">Filter users</span><span aria-hidden="true">⌕</span><input type="search" data-table-search placeholder="Search users" autocomplete="off"></label><% } %>
      <a class="text-link" href="/">← Back home</a>
    </div>
  </div>
  <% if (users.length) { %>
    <div class="table-tools" data-table-tools>
      <div class="table-wrap">
        <table data-sortable-table>
          <thead><tr>
            <th scope="col" aria-sort="none"><button class="sort-button" type="button" data-sort-column="0">Email <span aria-hidden="true">↕</span></button></th>
            <th scope="col" aria-sort="none"><button class="sort-button" type="button" data-sort-column="1">Name <span aria-hidden="true">↕</span></button></th>
            <th scope="col" aria-sort="none"><button class="sort-button" type="button" data-sort-column="2">Username <span aria-hidden="true">↕</span></button></th>
            <th scope="col">Role</th>
            <th scope="col">Actions</th>
          </tr></thead>
          <tbody>
            <% users.forEach((user) => { const name = [user.FirstName, user.LastName].filter(Boolean).join(" ") || "—"; %>
              <tr data-filter-row data-search="<%= [user.email, name, user.Username].filter(Boolean).join(' ') %>">
                <td class="email-cell" data-sort-value="<%= user.email %>"><%= user.email %></td>
                <td data-sort-value="<%= name %>"><%= name %></td>
                <td data-sort-value="<%= user.Username || '' %>"><span class="username-chip"><%= user.Username || "—" %></span></td>
                <td><span class="username-chip"><%= user.isAdmin ? "Administrator" : "User" %></span></td>
                <td>
                  <div class="row-actions">
                    <% if (user.hasAuthAccount) { %>
                      <a class="button button-small button-outline" href="/users/<%= encodeURIComponent(user.UserID) %>/edit">Edit</a>
                      <% if (String(user.AuthUserID) !== String(adminId)) { %>
                        <form action="/users/<%= encodeURIComponent(user.UserID) %>/admin-role" method="post" <%= user.isAdmin ? 'data-confirm="Remove administrator access from this account?"' : '' %>>
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <input type="hidden" name="admin_action" value="<%= user.isAdmin ? 'revoke' : 'grant' %>">
                          <button class="button button-small <%= user.isAdmin ? 'button-danger' : 'button-outline' %>" type="submit"><%= user.isAdmin ? "Remove admin" : "Make admin" %></button>
                        </form>
                      <% } %>
                    <% } %>
                    <% if (String(user.AuthUserID) !== String(adminId)) { %>
                      <form action="/users/<%= encodeURIComponent(user.UserID) %>/delete" method="post" data-confirm="Delete this user account and profile?">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button class="button button-small button-danger" type="submit">Delete</button>
                      </form>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <p class="filter-empty" data-filter-empty hidden>No users match your search.</p>
    </div>
  <% } else { %>
    <div class="empty-state"><span class="empty-icon">◎</span><h3>No users yet</h3><p>Create a user record to get started.</p><a class="button button-primary" href="/users/new">Add first user</a></div>
  <% } %>
</section>
<%- include("partials/footer") %>
