<%- include("partials/header", { title: pageTitle, loggedIn, adminEmail, notice }) %>
<section class="page-heading compact-heading">
  <div><p class="eyebrow">ADMIN WORKSPACE / RECORDS</p><h1><%= pageTitle %></h1><p class="lead-small">This record is saved to the shared Coursewise Tasks table.</p></div>
  <a class="text-link" href="/records">← Back to records</a>
</section>
<section class="form-panel">
  <% if (!users.length) { %>
    <div class="inline-notice">Add a Coursewise user before creating a record.</div>
    <a class="button button-primary" href="/users/new">Add user</a>
  <% } else { %>
    <form action="<%= formAction %>" method="post" class="record-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-grid">
        <div class="field full-field"><label for="name">Record name</label><input id="name" name="name" type="text" maxlength="300" value="<%= record ? record.Name : '' %>" required></div>
        <div class="field full-field">
          <label for="user_id">Assign to</label>
          <select id="user_id" name="user_id" required>
            <option value="">Choose a user</option>
            <% users.forEach((user) => { const displayName = [user.FirstName, user.LastName].filter(Boolean).join(" ") || user.Username || "Coursewise user"; %>
              <option value="<%= user.UserID %>" <%= record && String(record.UserID) === String(user.UserID) ? "selected" : "" %>><%= displayName %></option>
            <% }) %>
          </select>
        </div>
        <div class="field"><label for="due_date">Due date</label><input id="due_date" name="due_date" type="date" value="<%= record ? dateForInput(record.TaskDueDate) : '' %>"><span class="field-help">Leave blank if there is no due date.</span></div>
        <label class="check-field"><input name="is_complete" type="checkbox" <%= record && record.IsComplete ? "checked" : "" %>><span class="check-box"></span><span><b>Mark as complete</b><small>Update the record status in Coursewise.</small></span></label>
      </div>
      <div class="form-actions"><a class="button button-outline" href="/records">Cancel</a><button class="button button-primary" type="submit"><%= record ? "Save changes" : "Create record" %></button></div>
    </form>
  <% } %>
</section>
<%- include("partials/footer") %>
